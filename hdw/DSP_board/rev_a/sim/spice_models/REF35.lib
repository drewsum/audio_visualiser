.SUBCKT BANDGAP_0 En Gnd Vin Vref Veps 
+ PARAMS: Evout=5m Tvout=0.5 Vref=1.25 Rout=10 Venthr=0.5 Vref0=1.25 NLF=1 FLW=0.01  NVR=1 Fh=200 Vinl=2 
+ DVoDVin=4 Vrefpsr=3 Fzpsr=20 Fppsr=1k Fzpsr1=10k Fppsr1=1000k Fppsr2=100Meg
* Output voltage accuracy ±0.025 max, 5m typ [%]
* Output voltage temperature coefficient 2 ppm/°C max, 0.5 typ [ppm/°C]
.PARAM R0 = {Rout}
.PARAM DVO_DT = { Tvout*1e-6 }
* Using Tvout parameters 
*.PARAM Vrefo = {Vref*(1 + Evout/100 + 2*DVO_DT)}   
*.PARAM TC1= {DVO_DT/R0/I0}
.PARAM TC1= {DVO_DT}
.PARAM Mdvodt = {1}     ; Tvout is used
* Using EDVO_DT Table 
*.PARAM Vrefo = {Vref}
.PARAM Vrefo = {Vref*(1 + Evout/100)}
*.PARAM TC1= {0}
.PARAM I0 = {Vrefo/R0}
.PARAM Cout={1/(2*Pi*Rout*Fh)}
.PARAM Rpsr= 1k
.PARAM DVO_DVIN = { DVoDVin*1e-6/Vref } 
*.PARAM Cpsr={1/(2*Pi*Rpsr*Fpsr)}
.PARAM Gain={Vref/Vref0}

Xn Vref1 Vref2 VNoise PARAMS: NLF={Gain*NLF} FLW={FLW}  NVR={Gain*NVR}

* Using Evout, Tvout parameters 
G1 Gnd Vref0 Value = {V(EN)*I0} ; Tvout is used
R1 Gnd Vref0 RMOD2 {R0}
CG1 Gnd Vref0 1p
E1 Vref1 Gnd Value = { V(Vref0)*(1 + V(Veps)) }
RE1 Vref1 Gnd 1k 
R2 Vref2 Vref {Rout}
C1 Vref Gnd {Cout}

*G2 0 Vpsr Value = {DVO_DVIN/Rpsr*(V(Vin,Gnd)-Vrefpsr)}
*R3 0 Vpsr {Rpsr}
*C2 Vpsr 0 {Cpsr}

.PARAM fpPSRR1= {Fppsr}
.PARAM fzPSRR1= {Fzpsr}
.PARAM R11ops= {(fpPSRR1/fzPSRR1 - 1)*R1ops}
.PARAM L1ops= {R11ops/(2*pi*fpPSRR1)}
.PARAM R10ps= {1k}
.PARAM C2ps= {1/(2*pi*R10ps*fpPSRR2)}
*.PARAM R11ps= {1m}
.PARAM R1ops= {1}
.PARAM fpPSRR10= {Fppsr1}
.PARAM fzPSRR10= {Fzpsr1}
.PARAM R110ops= {(fpPSRR10/fzPSRR10 - 1)*R10ops}
.PARAM L10ops= {R110ops/(2*pi*fpPSRR10)}
.PARAM R10ops= {1}

.PARAM fpPSRR2= {Fppsr2}
G1ops       0 Vz1 VALUE = {-DVO_DVIN*(V(Vin,Gnd)-Vrefpsr)}
*R11ps       4 0 {R11ps} 
R10ps       Vz100 Veps {R10ps} 
C2ps        Veps 0  {C2ps}
R11ops      5 0 {R11ops} 
L1ops       5 0  {L1ops}
R1ops       Vz1 5 {R1ops} 
G10ops       0 Vz10 VALUE = {V(Vz1)}
R110ops      50 0 {R110ops} 
L10ops       50 0  {L10ops}
R10ops       Vz10 50 {R10ops} 
G100ops       0 Vz100 VALUE = {V(Vz10)}
R1100ops      500 0 {R110ops} 
L100ops       500 0  {L10ops}
R100ops       Vz100 500 {R10ops} 

.MODEL RMOD2 RES (TC1={TC1} TC2=0 TCE=0)
.ENDS

.SUBCKT VNoise 1 2
+ PARAMS: 
* nV/RHz AT 1/F FREQ
+ NLF=1
* FREQ FOR 1/F VAL
+ FLW=0.01
* nV/RHz FLATBAND
+ NVR=1
.PARAM GLF={PWR(FLW,0.25)*NLF/1164}
.PARAM RNV={1.184*PWR(NVR,2)}
.MODEL DVN D KF={PWR(FLW,0.5)/1E11} IS=1.0E-16
I1 0 7 10E-3
I2 0 8 10E-3
D1 7 0 DVN
D2 8 0 DVN
R1 5 0 {RNV}
R2 5 0 {RNV}
E1 1 2 Value= {GLF*V(7,8) + 10*V(5)}
RE1 1 2 1k  
.ENDS

.SUBCKT D_DINEN_0 1    2 Params: Ien=3.2u
D1 1 2  Dph
*.MODEL Dph D( IS=12.7389n N=1.0 XTI=0 RS=10 T_ABS=25 )
.MODEL Dph D( IS={Ien} N=1.0 RS=10 T_ABS=27 )
.ENDS

.SUBCKT HYSTCOMPG_0 inp inm out gnd 
+ Params: Vthres=0 Vhyst=1 VoutH=5 VoutL=0 Rout=1 Tdel=1N
*
.PARAM Delay = {MAX(Tdel,1n)}
.Param Rdel = {IF ( (Delay > 1E-15) & (Rout < 1), 1, Rout ) }
.Param VoutM={(VoutH+VoutL)/2}
.Param VthH={Vthres + 0.5*Vhyst}
.Param VthL={Vthres - 0.5*Vhyst}
.Param Cout={Delay/(0.693*(Rdel+1u))}
.Param Gdlh={1/Rdel}
.Param Gdhl={1*Gdlh}
*
Gthr gnd thr Value= { IF ( V(out,gnd) < {VoutM}, {VthH}, {VthL}) }
Rthr gnd thr 1
Gout gnd out Value= { IF ( (V(inp,inm) > V(thr,gnd)), (VoutH - V(out,gnd))*Gdlh, (VoutL - V(out,gnd))*Gdhl ) }
Cout out gnd {Cout}
Rout out gnd {1e5*Rdel}
.ENDS

.SUBCKT D_DIN_0 1    2
D1 1 2  Dnh
.MODEL Dnh D( IS=12.4889n N=1.0 XTI=0 RS=10 EG=0.94 T_ABS=27 )
.ENDS

.SUBCKT D_DIN_1 1    2
D1 1 2  Dph
.MODEL Dph D( IS=12.7389n N=1.0 XTI=0 RS=10 EG=0.94 T_ABS=27 )
.ENDS

.SUBCKT GAINSET_0 1 2 3 PARAMS: Gerr=0.05 Gerr_Tc=0.5 G = 2 fh=10k RG = 100000k
* Gain error 0.05 ±0.15 % of FSR
* Gain temperature coefficient AVDD=+5V: ±0.5,  AVDD=+2.0V: ±1.5 ppm of  FSR/°C

.PARAM G_err = {(Gerr-0.0015)*0.01}
.PARAM G_Tc = {Gerr_Tc*1e-6}
.PARAM RG_Tc = {1*G_Tc}
.PARAM RG2 = {(1+G_err)*RG*(G-1)/G}
.PARAM RG1 = {(1-G_err)*RG/G}
.PARAM G2 = {1/Max(RG2,100m)}
.PARAM G1 = {1/Max(RG1,100m)}
.PARAM C2 = {G2/(2*pi*fh)}
*R1 1 3 RMOD1 {RG1}
GR1 1 3 Value = {V(1,3)*G1}
*R2 3 2 RMOD2 {RG2}
*C1 1 3 {C2/1}
GR2 3 2 Value = {V(3,2)*G2}
C2 3 2 {C2}
.MODEL RMOD1 RES (TC1={-RG_Tc} TC2=0 TCE=0)
.MODEL RMOD2 RES (TC1={RG_Tc} TC2=0 TCE=0)
.ENDS

.SUBCKT D_LIMN1_0 1 2 Params: N=1 RS=100
D1 1 2  D_LimN1
*.MODEL D_LIM01 D( IS=10F N=0.1 RS=1 XTI=0 AF=0 KF=0 EG=0.111 T_ABS=27)
*.MODEL D_LIM01 D( IS=10F N=0.1 RS=100 XTI=0 AF=0 KF=0 T_ABS=27)
.MODEL D_LIMN1 D( IS=10F N={N} RS={RS} XTI=0 AF=0 KF=0 T_ABS=27)
.ENDS

